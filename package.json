{
  "name": "my12306",
  "version": "1.0.0",
  "private": true,
  "description": "12306 自动购票软件（管理台 + 后端服务，全 TypeScript）",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build:server": "npm run build --workspace server",
    "build:web": "npm run build --workspace web",
    "start:server": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "test": "npm run test:date-engine --workspace server && npm run test:feishu --workspace server && npm run test:regression && npm run test:features && npm run test:qr-login && npm run test:plan-status && npm run test:desktop-transport && npm run test:seat-result && npm run test:notification-network",
    "test:qr-login": "node --import tsx --test server/src/__test__/qr-login.test.ts server/src/__test__/session-check.test.ts",
    "test:regression": "node --import tsx server/src/__test__/regression.test.ts",
    "test:features": "node --import tsx server/src/__test__/features.test.ts",
    "desktop:install": "npm --prefix desktop ci && npm --prefix desktop/app ci --ignore-scripts",
    "desktop:prepare": "npm --prefix desktop run prepare:app",
    "desktop:start": "npm --prefix desktop run start --",
    "desktop:pack": "npm --prefix desktop run pack",
    "desktop:dist": "npm --prefix desktop run dist",
    "desktop:dist:unsigned": "npm --prefix desktop run dist:unsigned",
    "desktop:dist:signed": "npm --prefix desktop run dist:signed",
    "test:plan-status": "node --import tsx --test server/src/__test__/plan-status.test.ts server/src/__test__/task-recovery.test.ts server/src/__test__/plan-skip.test.ts server/src/__test__/cancel-order.test.ts",
    "test:desktop-transport": "node --import tsx --test server/src/__test__/desktop-transport.test.ts server/src/__test__/api-post.test.ts desktop/scripts/transport.test.cjs",
    "test:seat-result": "node --import tsx --test server/src/__test__/seat-result.test.ts server/src/__test__/order-price.test.ts server/src/__test__/personal-orders.test.ts server/src/__test__/existing-ticket.test.ts server/src/__test__/reconcile.test.ts",
    "test:notification-network": "node --import tsx --test server/src/__test__/notification-network.test.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
